PORT=8001
EVOLUTION_URL=http://evolution-api:8080
EVOLUTION_API_KEY=dev-evolution-key
EVOLUTION_INSTANCE=agproto
CORE_URL=http://core:8090
INTERNAL_API_KEY=devkey
WEBHOOK_SECRET=dev-webhook-secret
ALLOW_GROUPS=false
# Keep reconnect/history-sync messages in the inbox without replying to them.
SUPPRESS_HISTORY_REPLIES=true
# Permit a little device/server clock skew for messages sent at startup.
HISTORY_REPLAY_CLOCK_SKEW_SECONDS=10
