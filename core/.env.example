# App
APP_NAME=TrTalk Core
DEBUG=true
# API port (make dev honors it — change when running several stacks at once)
PORT=8090

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=trtalk

# JWT (admin authentication)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5191,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Internal API key — shared secret the WhatsApp gateway uses to call /ingest
# INTERNAL_API_KEY=your_api_key_here

# LLM — provider/model swappable via init_chat_model (app/core/llm.py)
#   google + gemini-2.5-flash (stable, multimodal) | gemini-3-flash-preview
#   anthropic + claude-sonnet-4-6 | openai + gpt-5-mini
#   openrouter + vendor/model | ollama + llama3.3 (local)
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
LLM_THINKING_BUDGET=0  # 0 = fastest replies; raise only when extra reasoning is needed
LLM_TEMPERATURE=0     # deterministic language/script choice
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # any OpenAI-compatible server
#
# Groq preset (text + images in one model; keep GOOGLE_API_KEY for embeddings):
#   LLM_PROVIDER=openai
#   LLM_MODEL=qwen/qwen3.8-27b
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=<groq key>
#   LLM_REASONING_EFFORT=none   # no hidden reasoning: fastest, no <think> leak
# LLM_REASONING_EFFORT=        # OpenAI-compatible reasoning models; empty = default
#
# Per-language route: text turns whose reply language is one of these go to a
# second OpenAI-compatible model (media turns stay on the primary). Sarvam
# writes natural Roman/Gurmukhi Punjabi where general models drift to Hindi.
# Falls back to the primary model if it errors.
# LLM_ALT_LANGUAGES=pa-IN
# LLM_ALT_MODEL=sarvam-105b-conversations
# LLM_ALT_BASE_URL=https://api.sarvam.ai/v1
# LLM_ALT_API_KEY=             # empty = SARVAM_API_KEY
#
# Sarvam Language ID (language/script lock per turn). Its own key, so it keeps
# working whichever host serves the chat model.
# SARVAM_API_KEY=
# SARVAM_LID_ENABLED=true
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Modality overrides for models the capability registry doesn't know
# (app/core/llm_capabilities.py). Unset = auto-detect by model name.
# LLM_SUPPORTS_VISION=true
# LLM_SUPPORTS_AUDIO=false

# Speech-to-text. An enabled provider transcribes every voice note before the
# chat turn, so the newest spoken text determines the reply language. Groq
# Whisper Turbo is the low-latency default; `gemini` uses GOOGLE_API_KEY rather
# than STT_API_KEY.
# For Hindi/Punjabi prefer Sarvam (STT_PROVIDER=sarvam, STT_MODEL=saaras:v3):
# far lower error rates than Whisper on Indic speech, and it returns the
# spoken language, which then sets the reply language without a LID call.
# STT_PROVIDER=groq            # "" disabled | groq | sarvam | gemini | openai | <compatible>
# STT_API_KEY=                 # required when enabled; NOT your LLM key
# STT_MODEL=whisper-large-v3-turbo # Gemini: gemini-3.5-transcribe
# STT_BASE_URL=                # optional; defaults: groq→api.groq.com/openai/v1
# STT_LANGUAGE=                # optional ISO-639-1 hint; empty = auto-detect
# STT_TIMEOUT_SECONDS=30

# Embeddings (memory + FAQ-RAG) — provider-swappable like the LLM.
# The dimension comes from EMBEDDING_DIM below (default 768 — quality ~equal,
# 4x cheaper than 3072). Providers and how they honor it:
#   google + gemini-embedding-001 (Matryoshka -> 768 requested)
#   openai + text-embedding-3-small (dimensions=768 requested)
#   ollama + nomic-embed-text (768 native, local)
# Switching providers requires re-embedding existing rows.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
# Vector width — PROVISION-TIME: baked into the schema on first migrate.
# Changing it later = column migration + re-embed. <=2000 HNSW-indexable as
# vector; 3072 (gemini native) uses halfvec index; >4000 exact scan only.
EMBEDDING_DIM=768

# Media storage (ADR-003) — S3-compatible via boto3. OPTIONAL: leave unset
# and inbound media is processed in-turn but not persisted (no images/audio
# in the admin timeline). The same four vars cover AWS S3, Cloudflare R2,
# DigitalOcean Spaces, Backblaze B2 and the local dev bucket (RustFS in the
# parent docker-compose — `docker compose up -d storage storage-init`):
#     STORAGE_ENDPOINT_URL=http://localhost:9000
#     STORAGE_BUCKET=trtalk-media
#     STORAGE_ACCESS_KEY=trtalk
#     STORAGE_SECRET_KEY=trtalk-secret
#   AWS S3: omit STORAGE_ENDPOINT_URL, set STORAGE_REGION.
# STORAGE_ENDPOINT_URL=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=
# Split-horizon only (docker-compose): browser-reachable endpoint for
# presigned URLs when it differs from STORAGE_ENDPOINT_URL.
# STORAGE_PUBLIC_ENDPOINT_URL=

# Canonical outbound seam (ADR-004) — one var per channel: where the core
# POSTs operator messages (the mirror of /ingest, same INTERNAL_API_KEY).
# Unset = sending from the admin panel fails with a clear error.
# CHANNEL_WHATSAPP_SEND_URL=http://localhost:8000/send
# CHANNEL_TELEGRAM_SEND_URL=http://localhost:8001/send
# CHANNEL_WEB_SEND_URL=http://localhost:8002/send   # web widget gateway (ADR-011)

# Inbound coalescing (ADR-008) — wait N seconds of SILENCE after the last
# message, then run ONE turn over the whole burst (coherent reply, 1 turn not
# N). The reply goes out via the send seam above, so CHANNEL_<CH>_SEND_URL is
# REQUIRED per active channel when this is > 0. Default 5; 0 = legacy
# synchronous reply in the /ingest response (no worker, no send-url needed).
# INBOUND_DEBOUNCE_SECONDS=5

# Handoff notifications (ADR-004) — both OPTIONAL, both best-effort.
# Webhook: POSTs {event, reason, at, contact} on handoff (Slack/Zapier/n8n).
# NOTIFY_WEBHOOK_URL=
# SMTP: one plain-text email per handoff through ANY relay — Brevo
# (smtp-relay.brevo.com:587), Mailgun, SES, or a Gmail app password.
# Port 587 = STARTTLS, 465 = implicit SSL.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=trtalk@yourdomain.com
# NOTIFY_EMAIL_TO=ops@yourdomain.com   # comma-separated

# Agent turn
HISTORY_LIMIT=20

# Sent verbatim to the end user when a turn fails — write it in YOUR users'
# language (the only user-facing literal; the agent itself replies in the
# user's language per the system prompt).
# FALLBACK_REPLY=Lo siento, tuve un problema procesando tu mensaje. ¿Puedes intentarlo de nuevo en un momento?
